rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // members/{uid} にドキュメントがある人だけが使える
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    // 自分が登録済みかどうかだけ確認できる（追加・変更はコンソールから）
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /txns/{id}     { allow read, write: if isMember(); }
    match /counts/{id}   { allow read, write: if isMember(); }
    match /sales/{id}    { allow read, write: if isMember(); }
    match /settings/{id} { allow read, write: if isMember(); }
  }
}
